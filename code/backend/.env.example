DB_USER=postgres
DB_HOST=localhost
DB_NAME=oquv_markaz
DB_PASSWORD=your_database_password
DB_PORT=5432
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_to_a_long_minio_password
MINIO_BUCKET=oquv-files
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me_telegram_webhook
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limit sozlamalari (millisekundlarda). Default: 15 minut.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# reCAPTCHA sozlamalari. Productionda captcha majburiy.
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key
DISABLE_RECAPTCHA=false

# Birinchi ishga tushishda baza bo'sh bo'lsa, shu accountlar auth_users jadvaliga seed qilinadi.
# Keyin login/parollarni /auth/users API orqali bazadan boshqaring.
# Login yoki parol bo'sh bo'lsa, u account ishlatilmaydi.
LOGIN_USER_1=admin
LOGIN_PASSWORD_1=admin_password
LOGIN_ROLE_1=ADMIN
LOGIN_USER_2=director
LOGIN_PASSWORD_2=director_password
LOGIN_ROLE_2=DIRECTOR
LOGIN_USER_3=manager
LOGIN_PASSWORD_3=manager_password
LOGIN_ROLE_3=MANAGER
LOGIN_USER_4=teacher
LOGIN_PASSWORD_4=teacher_password
LOGIN_ROLE_4=TEACHER
LOGIN_USER_5=student
LOGIN_PASSWORD_5=student_password
LOGIN_ROLE_5=STUDENT
